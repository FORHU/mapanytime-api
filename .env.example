PORT=4002
NODE_ENV="development"

# Browser origins allowed to call this API, comma-separated. Leave unset in
# local dev to allow any origin. MUST be set in staging/production: the API
# sends `Access-Control-Allow-Credentials: true`, and browsers reject that
# alongside a wildcard origin, so every credentialed request would fail.
# Native clients (the Flutter app) don't send an Origin header and are unaffected.
# e.g. CORS_ORIGIN="http://localhost:4000,http://your-host:4000"
CORS_ORIGIN=

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/node_postg_db?schema=public"

# Docker Compose only (service interpolation in docker-compose.yml).
# In-container DATABASE_URL/REDIS_HOST/RABBITMQ_URL are derived from these.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=node_postg_db
POSTGRES_PORT=5432
REDIS_INSIGHT_PORT=5540
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Authentication (JWT)
# JWT_SECRET / JWT_REFRESH_SECRET / JWT_EXPIRY are accepted as older spellings
# of the three below — config.ts falls back to them, so an environment setting
# either half works.
ACCESS_TOKEN_SECRET="your-access-token-secret"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"
ACCESS_TOKEN_EXPIRY="1d"
REFRESH_TOKEN_EXPIRY="30d"

# AI Services
OPENAI_API_KEY="sk-proj-your-openai-api-key"
CHAT_WONDER_API_URL="http://your-chat-wonder-api-url"

# Mailer (Ethereal for Testing)
MAILER_TRANSPORT_HOST="smtp.ethereal.email"
MAILER_TRANSPORT_PORT=587
MAILER_TRANSPORT_SECURE=false
MAILER_EMAIL="your-ethereal-email@ethereal.email"
MAILER_PASSWORD="your-ethereal-password"

# Redis Cache & Rate Limiting
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TTL_SECONDS=3600
REDIS_TLS=false               # Set to true for managed Redis (AWS ElastiCache, Upstash)

# Worker Process
WORKER_HEALTH_PORT=8080       # Health probe port for Kubernetes/ECS — separate from API
METRICS_INTERVAL_MS=60000     # How often WorkerMetrics persists a snapshot to Redis

# AWS S3 & CloudFront
# AWS_ACCESS_KEY and S3_BUCKET are accepted as older spellings of
# AWS_ACCESS_KEY_ID and AWS_S3_BUCKET_NAME. Set either, not both — if both are
# present the canonical name below wins, which is a confusing way to find out
# your override was ignored.
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"
S3_CDN_URL="https://your-cloudfront-id.cloudfront.net"

# RabbitMQ Configuration
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
RABBITMQ_EXCHANGE="app_events_exchange"
RABBITMQ_QUEUE_PREFIX="app"
INGESTION_QUEUE_NAME="ingestion_jobs"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Base URL of the buyer-facing web app, used to build absolute success/cancel
# redirect URLs for hosted checkout pages (PayMongo, Xendit) when the client
# doesn't supply its own.
#
# Xendit validates this before it will create a payment session, and rejects
# far more than "not HTTPS" — verified against the live sandbox 2026-08-25:
#
#   https://app.example.com       201    domain, no port
#   https://127.0.0.1             201    a bare IPv4 is fine
#   https://localhost             400    the hostname itself is denied
#   https://app.example.com:443   400    ANY explicit port, even the default
#   http://app.example.com        400    scheme must be https
#
# Every rejection is the same opaque 400 INVALID_URL / "Please provide a valid
# HTTPS URL", which names only the scheme — so a port sends you hunting in the
# wrong place. This used to default to http://localhost:3000, which fails on
# two of the three counts and broke every Xendit checkout.
#
# For local device testing use your Tailscale IPv4 with no port. The redirect
# will not resolve, but nothing depends on it — the order is completed by the
# webhook. assertCheckoutReturnUrl() in src/config.ts checks all three rules at
# startup: it throws in production and warns in development.
#
# FRONTEND_URL is still read as the older spelling if this one is unset.
MAPANYTIME_WEB_APP_URL="https://app.example.com"

# PayMongo — required for real checkout. Without PAYMONGO_SECRET_KEY,
# PaymentService.getProviderAdapter() silently falls back to MockProvider,
# which is a no-op in production (checkout redirects to a dead /mock-checkout
# page). Get both from the PayMongo dashboard: sk_test_/sk_live_ under
# Developers > API Keys, webhook secret under Developers > Webhooks.
PAYMONGO_SECRET_KEY="sk_test_your-paymongo-secret-key"
PAYMONGO_WEBHOOK_SECRET_KEY="whsk_your-paymongo-webhook-secret"
PAYMONGO_API_URL="https://api.paymongo.com/v1"

# Xendit — Dashboard > Settings > API Keys (use the xnd_development_...
# secret key for sandbox, not the Public Key). Same keyless-fallback
# behavior as PayMongo above.
XENDIT_SECRET_KEY="xnd_development_your-xendit-secret-key"
# Dashboard > Settings > Webhooks > Verification Token.
XENDIT_WEBHOOK_TOKEN="your-xendit-webhook-verification-token"
XENDIT_API_URL="https://api.xendit.co"
