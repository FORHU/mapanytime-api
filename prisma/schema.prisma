generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// 👤 FEATURE DOMAIN: USERS, AUTH & PROFILES
// =========================================================================

model Users {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  activeSessionId String?
  firstName       String?
  lastName        String?
  phoneNumber     String?
  avatarFileId    String?           @unique
  userReferralId  String?
  accountStatus   USERACCOUNTSTATUS @default(ACTIVE)
  isEmailVerified Boolean           @default(false)
  isOnBoarding    Boolean           @default(false)
  countryCode     String?
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  roles              Roles[]                 @relation("UserRoles")
  avatarFile         Files?                  @relation("UserAvatar", fields: [avatarFileId], references: [id])
  session            Session[]
  seller             Sellers?
  buyer              Buyers?
  verifiedDocuments  DocumentVerifications[]
  sentAdminInvites   AdminInvites[]
  notifications      Notifications[]
  reviewedProperties ProductProperties[]     @relation("PropertyReviewers")
  reviewedStores     Stores[]                @relation("StoreReviewers")
  userReferral       Users?                  @relation("UserReferrals", fields: [userReferralId], references: [id])
  userReferrals      Users[]                 @relation("UserReferrals")

  @@unique([userReferralId, id])
  @@index([userReferralId])
  @@index([email])
  @@index([accountStatus])
}

model Roles {
  id          String            @id @default(cuid())
  roleName    String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  users       Users[]           @relation("UserRoles")
  permissions RolePermissions[]
}

model Permissions {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  roles       RolePermissions[]
}

model RolePermissions {
  roleId       String
  permissionId String
  role         Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@id([roleId, permissionId])
}

enum USERACCOUNTSTATUS {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
  UNDER_REVIEW
  BANNED
  NEED_REVISSION
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  refreshToken   String?   @unique
  provider       String
  accessToken    String?
  avatarUrl      String?
  providerUserId String?
  scopes         String?
  updatedAt      DateTime  @updatedAt
  users          Users     @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
}

model Files {
  id              String    @id @default(cuid())
  filename        String
  originalName    String
  mimeType        String
  size            Int
  storageProvider String    @default("S3")
  bucket          String?
  path            String
  checksum        String?
  uploadedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  avatarUser      Users?            @relation("UserAvatar")
  documents       Documents[]
  productImages   ProductImages[]
  logoStores      Stores[]          @relation("StoreLogo")
  bannerStores    Stores[]          @relation("StoreBanner")
  propertiesFiles PropertiesFiles[] @relation("PropertyFiles")
}

model Sellers {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  applicationStatus     ApplicationStatus       @default(PENDING)
  sellerPlan            String?
  agentNotes            String?
  onboardingStep        Int                     @default(0)
  isOnboarded           Boolean                 @default(false)
  onboardedAt           DateTime?
  documentVerifications DocumentVerifications[]
  users                 Users                   @relation(fields: [userId], references: [id])
  stores                Stores[]
  supplierProducts      SupplierProducts[]
  settlements           Settlements[]
  payouts               SellerPayouts[]
  returnRequests        ReturnRequests[]
}

model PropertiesFiles {
  id         String     @id @default(cuid())
  propertyId String
  fileId     String
  titleType  TITLETYPE?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  property ProductProperties @relation(fields: [propertyId], references: [id])
  file     Files             @relation("PropertyFiles", fields: [fileId], references: [id])

  @@index([propertyId])
}

model ProductProperties {
  id               String         @id @default(cuid())
  storeId          String
  sellerCapacity   SELLERCAPACITY
  legalName        String
  governmentIdName String?
  propertyType     PROPERTYTYPE
  address          String
  latitude         Float
  longitude        Float
  subdivision      String?
  status           PROPERTYSTATUS @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  rejectionReason  String?
  reviewedAt       DateTime?
  reviewedById     String?

  // Specs (Step 3: Property Specifications)
  lotArea       Float?
  terrain       TERRAIN?
  floorArea     Float?
  bedrooms      Int?
  bathrooms     Int?
  parkingSpaces Int?
  yearBuilt     Int?
  furnishing    FURNISHING?

  // Pricing & financial terms
  sellingPrice        Decimal?           @db.Decimal(12, 2)
  negotiability       NEGOTIABILITY?
  taxResponsibilities TAXRESPONSIBILITY?
  hoaDues             Decimal?           @db.Decimal(12, 2)

  store         Stores            @relation("StoreProperties", fields: [storeId], references: [id])
  reviewedBy    Users?            @relation("PropertyReviewers", fields: [reviewedById], references: [id])
  propertyFiles PropertiesFiles[]

  @@index([storeId])
  @@index([propertyType])
  @@index([status])
  @@index([latitude, longitude])
  @@map("PropertiesProducts")
}

enum SELLERCAPACITY {
  OWNER
  BROKER
  PROXY
}

enum PROPERTYTYPE {
  HOUSE_LOT
  RAW_LAND
}

enum TERRAIN {
  FLAT
  SLOPING
  ROLLING
  MOUNTAINOUS
}

enum FURNISHING {
  BARE
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum TITLETYPE {
  TCT
  OCT
  TAX_DECLARATION
}

enum NEGOTIABILITY {
  FIXED
  NEGOTIABLE
}

enum TAXRESPONSIBILITY {
  SELLER
  BUYER
  STANDARD_SHARING
}

enum PROPERTYSTATUS {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
}

model Buyers {
  id          String    @id @default(cuid())
  userId      String    @unique
  createdAt   DateTime  @default(now())
  displayName String
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users          Users                   @relation(fields: [userId], references: [id])
  review         StoreReviews[]
  orders         Orders[]
  addresses      BuyerAddresses[]
  reviews        ProductReviews[]
  cart           Carts?
  wishlist       Wishlists?
  returnRequests ReturnRequests[]
  reservations   InventoryReservations[]
}

model DocumentVerifications {
  id                 String             @id @default(cuid())
  sellerId           String
  storeId            String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  seller             Sellers            @relation(fields: [sellerId], references: [id])
  store              Stores?            @relation(fields: [storeId], references: [id])
  verifiedByAdmin    Users?             @relation(fields: [verifiedById], references: [id])
  documents          Documents[]
}

model Documents {
  id                      String                @id @default(cuid())
  documentVerificationsId String
  fileId                  String
  documentType            DOCUMENTTYPES
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  documentVerification    DocumentVerifications @relation(fields: [documentVerificationsId], references: [id])
  files                   Files                 @relation(fields: [fileId], references: [id])
}

enum DOCUMENTTYPES {
  TIN_ID
  GOV_ID
  DTI_CERTIFICATE
  MAYORS_PERMIT
  BIR_CERTIFICATE
  SEC_CERTIFICATE
}

model AdminInvites {
  id        String       @id @default(cuid())
  email     String       @unique
  token     String       @unique
  status    INVITESTATUS @default(PENDING)
  inviterId String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  inviter   Users        @relation(fields: [inviterId], references: [id])
}

enum INVITESTATUS {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// =========================================================================
// 🏪 FEATURE DOMAIN: STORES & SELLERS
// =========================================================================

model Stores {
  id                String              @id @default(cuid())
  sellerId          String
  storeName         String
  description       String?
  logoId            String?
  bannerId          String?
  slug              String?             @unique
  phone             String?
  email             String?
  returnPolicy      String?
  shippingPolicy    String?
  socialLinks       Json?
  ratingAverage     Float               @default(0)
  ratingCount       Int                 @default(0)
  followersCount    Int                 @default(0)
  primaryCategoryId String?
  vacationMode      Boolean             @default(false)
  isActive          Boolean             @default(false)
  approvalStatus    STOREAPPROVALSTATUS @default(PENDING)
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedById      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  logoFile              Files?                  @relation("StoreLogo", fields: [logoId], references: [id])
  bannerFile            Files?                  @relation("StoreBanner", fields: [bannerId], references: [id])
  primaryCategory       Categories?             @relation("StorePrimaryCategory", fields: [primaryCategoryId], references: [id])
  documentVerifications DocumentVerifications[]
  products              Products[]
  storeHours            StoreHours[]
  storeLocations        StoreLocations?
  storeReviews          StoreReviews[]
  seller                Sellers                 @relation(fields: [sellerId], references: [id])
  reviewedBy            Users?                  @relation("StoreReviewers", fields: [reviewedById], references: [id])
  categories            Categories[]            @relation("CategoriesToStores")
  orders                Orders[]
  inventory             Inventory[]
  inventoryMovements    InventoryMovements[]
  productProperties     ProductProperties[]     @relation("StoreProperties")
  merchantAds           MerchantAds[]

  @@index([sellerId])
  @@index([isActive])
  @@index([primaryCategoryId])
}

model StoreHours {
  id           String   @id @default(cuid())
  storeId      String
  dayOfWeek    Int
  openMinutes  Int // minutes since midnight, e.g. 480 = 08:00
  closeMinutes Int // minutes since midnight, e.g. 1020 = 17:00
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  store        Stores   @relation(fields: [storeId], references: [id])

  @@unique([storeId, dayOfWeek])
}

model StoreLocations {
  id             String   @id @default(cuid())
  storeId        String   @unique
  currentAddress String
  homeAddress    String
  city           String
  province       String
  zipCode        String
  country        String
  latitude       Float
  longitude      Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Stores   @relation(fields: [storeId], references: [id])

  @@index([latitude, longitude])
}

model StoreReviews {
  id        String   @id @default(cuid())
  storeId   String
  buyerId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Stores   @relation(fields: [storeId], references: [id])
  buyer     Buyers   @relation(fields: [buyerId], references: [id])

  @@unique([storeId, buyerId])
  @@index([storeId])
  @@index([buyerId])
}

enum MERCHANTADKIND {
  PROMO
  JOB
  EVENT
}

enum MERCHANTDISCOUNTTYPE {
  BOGO
  PERCENTAGE
  FIXED_AMOUNT
}

enum ADGOAL {
  STORE_VISITS
  IMPRESSIONS
  PURCHASES
}

enum ADFORMAT {
  MAP_FLOATING_CARD
  PROMOTED_PIN
  DISCOVERY_CAROUSEL
  SPONSORED_SEARCH
}

enum ADSTATUS {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  BUDGET_EXHAUSTED
}

model MerchantAds {
  id            String                @id @default(cuid())
  storeId       String
  kind          MERCHANTADKIND        @default(PROMO)
  title         String
  description   String
  imageUrl      String?
  badgeLabel    String?
  ctaLabel      String?
  salaryLabel   String?
  buyQuantity   Int?
  freeQuantity  Int?
  discountType  MERCHANTDISCOUNTTYPE?
  discountValue Decimal?              @db.Decimal(12, 2)
  isActive      Boolean               @default(true)

  // Campaign & Location Targeting (from Promote This Store Wizard)
  goal      ADGOAL   @default(STORE_VISITS)
  format    ADFORMAT @default(MAP_FLOATING_CARD)
  radiusKm  Int      @default(3)
  targetLat Float?
  targetLng Float?

  // Budget & Billing
  dailyBudget Decimal? @db.Decimal(12, 2)
  totalBudget Decimal? @db.Decimal(12, 2)
  spentAmount Decimal  @default(0) @db.Decimal(12, 2)

  // Aggregated Performance Counters
  impressionsCount  Int     @default(0)
  clicksCount       Int     @default(0)
  conversionsCount  Int     @default(0)
  attributedRevenue Decimal @default(0) @db.Decimal(12, 2)

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store      Stores               @relation(fields: [storeId], references: [id])
  products   MerchantAdProducts[]
  orderItems OrderItems[]
  adEvents   AdEvents[]

  @@index([storeId, isActive])
  @@index([radiusKm])
  @@index([expiresAt])
}

// Links an EVENT (or any ad) to the specific products/variants whose
// Inventory.quantityOnHand gauges whether it's still live.
model MerchantAdProducts {
  id        String  @id @default(cuid())
  adId      String
  productId String
  variantId String?

  ad      MerchantAds      @relation(fields: [adId], references: [id], onDelete: Cascade)
  product Products         @relation(fields: [productId], references: [id])
  variant ProductVariants? @relation(fields: [variantId], references: [id])

  @@unique([adId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

enum ADEVENTTYPE {
  IMPRESSION
  CLICK
  CONVERSION
}

model AdEvents {
  id            String      @id @default(cuid())
  adId          String
  eventType     ADEVENTTYPE
  buyerId       String?
  sessionId     String?
  orderId       String?
  revenueAmount Decimal?    @db.Decimal(12, 2)
  ipAddress     String?
  userAgent     String?
  occurredAt    DateTime    @default(now())

  ad MerchantAds @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, eventType, occurredAt])
  @@index([buyerId])
  @@index([orderId])
}

// =========================================================================
// 📦 FEATURE DOMAIN: PRODUCTS & CATALOG MANAGEMENT
// =========================================================================

enum PRODUCTSTATUS {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  HIDDEN
}

model Products {
  id            String        @id @default(cuid())
  storeId       String
  categoryId    String?
  name          String
  brand         String?
  description   String?
  price         Decimal       @db.Decimal(12, 2)
  ratingAverage Float         @default(0)
  ratingCount   Int           @default(0)
  isActive      Boolean       @default(false)
  status        PRODUCTSTATUS @default(APPROVED)
  totalSold     Int           @default(0)
  listedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  store              Stores               @relation(fields: [storeId], references: [id])
  category           Categories?          @relation(fields: [categoryId], references: [id])
  tags               ProductTags[]
  inventory          Inventory[]
  orderitems         OrderItems[]
  productImages      ProductImages[]
  supplierProducts   SupplierProducts[]
  variants           ProductVariants[]
  options            ProductOptions[]
  reviews            ProductReviews[]
  cartItems          CartItems[]
  wishlistItems      WishlistItems[]
  inventoryMovements InventoryMovements[]
  merchantAdLinks    MerchantAdProducts[]

  @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([status])
  @@index([storeId, status, isActive])
  @@index([categoryId, status, isActive])
}

model ProductVariants {
  id          String    @id @default(cuid())
  productId   String
  sku         String?   @unique
  variantName String
  price       Decimal   @db.Decimal(12, 2)
  costPrice   Decimal?  @db.Decimal(12, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  product            Products                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues       ProductVariantToOptionValue[]
  inventory          Inventory[]
  orderitems         OrderItems[]
  productImages      ProductImages[]
  cartItems          CartItems[]
  wishlistItems      WishlistItems[]
  inventoryMovements InventoryMovements[]
  merchantAdLinks    MerchantAdProducts[]

  @@index([productId])
  @@index([sku])
}

model ProductOptions {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Products              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValues[]

  @@index([productId])
}

model ProductOptionValues {
  id        String   @id @default(cuid())
  optionId  String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  option   ProductOptions                @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantToOptionValue[]

  @@index([optionId])
}

model ProductVariantToOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariants     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValues @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
}

model SupplierProducts {
  id              String   @id @default(cuid())
  sellerId        String
  productId       String
  supplierSku     String?  @unique
  costPrice       Decimal? @db.Decimal(12, 2)
  minimumOrderQty Int      @default(1)
  supplyLeadDays  Int      @default(1)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller  Sellers  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product Products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([productId])
}

model Categories {
  id                String              @id @default(cuid())
  parentId          String?
  name              String
  description       String?
  status            CategoryStatus      @default(APPROVED)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  parent            Categories?         @relation("CategoryToParent", fields: [parentId], references: [id])
  subCategories     Categories[]        @relation("CategoryToParent")
  products          Products[]
  stores            Stores[]            @relation("CategoriesToStores")
  primaryForStores  Stores[]            @relation("StorePrimaryCategory")
  commissionRules   CommissionRules?
  pricingComponents PricingComponents[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([status])
}

model Tags {
  id          String        @id @default(cuid())
  name        String        @unique
  createdAt   DateTime      @default(now())
  productTags ProductTags[]
}

model ProductTags {
  productId String
  tagId     String

  product Products @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tags     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum STOREAPPROVALSTATUS {
  PENDING
  ACTIVE
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryStatus {
  PENDING
  APPROVED
  REJECTED
}

// =========================================================================
// 🛒 FEATURE DOMAIN: ORDERS, CHECKOUT & INVENTORY
// =========================================================================

model Orders {
  id                   String  @id @default(cuid())
  buyerId              String
  storeId              String
  storeName            String?
  sellerName           String?
  storeAddressSnapshot String?
  sellerPhoneSnapshot  String?
  storeEmailSnapshot   String?
  totalAmount          Decimal @db.Decimal(12, 2)
  subtotalAmount       Decimal @default(0) @db.Decimal(12, 2)
  shippingAmount       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal @default(0) @db.Decimal(12, 2)
  marketplaceFeeAmount Decimal @default(0) @db.Decimal(12, 2)
  sellerNetAmount      Decimal @default(0) @db.Decimal(12, 2)

  // 1. Marketplace Commission (MapAnytime Platform Revenue)
  sellerMarketplaceFeeRate   Decimal @default(0.0200) @db.Decimal(8, 5) // e.g. 2.00%
  sellerMarketplaceFeeAmount Decimal @default(0) @db.Decimal(12, 2)

  // 2. Payment Provider Processing Cost (Actual cost charged by PayMongo / Bank / Card)
  paymentProviderFeeRate   Decimal? @db.Decimal(8, 5)
  paymentProviderFixedFee  Decimal? @db.Decimal(12, 2)
  paymentProviderFeeAmount Decimal  @default(0) @db.Decimal(12, 2)

  // 3. Buyer Transaction Fee (Amount charged to buyer based on PAYMENTFEEPAYER policy)
  buyerTransactionFeeRate   Decimal?        @db.Decimal(8, 5)
  buyerTransactionFeeAmount Decimal         @default(0) @db.Decimal(12, 2)
  paymentFeePayer           PAYMENTFEEPAYER @default(BUYER)

  currency    String           @default("PHP")
  version     Int              @default(0)
  type        FULLFILLMENTTYPE @default(PICKUP)
  status      ORDERSTATUS      @default(PENDING)
  pickupAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  buyer          Buyers                  @relation(fields: [buyerId], references: [id])
  store          Stores                  @relation(fields: [storeId], references: [id])
  orderitems     OrderItems[]
  payment        Payments[]
  settlement     Settlements?
  shipment       Shipments?
  returnRequests ReturnRequests[]
  reservations   InventoryReservations[]
  charges        OrderCharges[]

  @@index([buyerId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@index([buyerId, status])
  @@index([storeId, status])
}

enum FULLFILLMENTTYPE {
  DELIVERY
  PICKUP
}

enum ORDERSTATUS {
  PENDING
  PROCESSING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  FAILED
}

model OrderItems {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  productName    String?
  variantName    String?
  productSku     String?
  productBrand   String?
  productImage   String?
  categoryName   String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  appliedAdId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order     Orders           @relation(fields: [orderId], references: [id])
  product   Products         @relation(fields: [productId], references: [id])
  variant   ProductVariants? @relation(fields: [variantId], references: [id])
  appliedAd MerchantAds?     @relation(fields: [appliedAdId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([appliedAdId])
}

enum ORDERCHARGETYPE {
  PRODUCT
  DISCOUNT
  BUYER_TRANSACTION_FEE
  SELLER_MARKETPLACE_FEE
  PAYMENT_PROCESSING_FEE
  SHIPPING
  TAX
  PROMOTION
  PLATFORM_SUBSIDY
  SELLER_SUBSIDY
  CAMPAIGN
  REFUND
  ADJUSTMENT
}

enum CHARGEPAYER {
  BUYER
  SELLER
  PLATFORM
}

enum CHARGEBENEFICIARY {
  BUYER
  SELLER
  PLATFORM
  PAYMENT_PROVIDER
  COURIER
  GOVERNMENT
}

enum PROMOTION_FUNDING {
  SELLER
  PLATFORM
  SHARED
}

/// Itemized financial audit ledger for every transaction
model OrderCharges {
  id      String @id @default(cuid())
  orderId String

  type        ORDERCHARGETYPE
  source      String? // e.g. "PayMongo Gateway", "Standard 2.0% Commission", "Summer 10% Promo"
  description String?

  rate   Decimal? @db.Decimal(8, 5)
  amount Decimal  @db.Decimal(12, 2)

  payer       CHARGEPAYER
  beneficiary CHARGEBENEFICIARY

  createdAt DateTime @default(now())

  order Orders @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([type])
  @@index([payer])
  @@index([beneficiary])
}

model ProductImages {
