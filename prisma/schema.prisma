generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// 👤 FEATURE DOMAIN: USERS, AUTH & PROFILES
// =========================================================================

model Users {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  phoneNumber     String?
  avatarId        String?           @unique
  accountStatus   USERACCOUNTSTATUS @default(ACTIVE)
  isEmailVerified Boolean           @default(false)
  isOnBoarding    Boolean           @default(false)
  countryCode     String?
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  roles             Roles[]                 @relation("UserRoles")
  avatar            Files?                  @relation(fields: [avatarId], references: [id])
  session           Session[]
  seller            Sellers?
  buyer             Buyers?
  verifiedDocuments DocumentVerifications[]
  sentAdminInvites  AdminInvites[]
  notifications     Notifications[]

  @@index([email])
  @@index([accountStatus])
}

model Roles {
  id          String            @id @default(cuid())
  roleName    String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  users       Users[]           @relation("UserRoles")
  permissions RolePermissions[]
}

model Permissions {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  roles       RolePermissions[]
}

model RolePermissions {
  roleId       String
  permissionId String
  role         Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@id([roleId, permissionId])
}

enum USERACCOUNTSTATUS {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  refreshToken   String?   @unique
  provider       String
  accessToken    String?
  avatarUrl      String?
  providerUserId String?
  scopes         String?
  updatedAt      DateTime  @updatedAt
  users          Users     @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
}

model Files {
  id        String      @id @default(cuid())
  userId    String
  fileName  String
  fileUrl   String
  metaData  Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  documents Documents[]
  products  Products[]
  users     Users?
  productImages ProductImages[]
}

model Sellers {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  applicationStatus     ApplicationStatus       @default(PENDING)
  documentVerifications DocumentVerifications[]
  users                 Users                   @relation(fields: [userId], references: [id])
  stores                Stores[]
  supplierProducts      SupplierProducts[]
  settlements           Settlements[]
  payouts               SellerPayouts[]
  returnRequests        ReturnRequests[]
}

model Buyers {
  id          String   @id @default(cuid())
  userId      String   @unique
  createdAt   DateTime @default(now())
  displayName String
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users          Users            @relation(fields: [userId], references: [id])
  review         StoreReviews[]
  orders         Orders[]
  addresses      BuyerAddresses[]
  reviews        ProductReviews[]
  cart           Carts?
  wishlist       Wishlists?
  returnRequests ReturnRequests[]
}

model DocumentVerifications {
  id                 String             @id @default(cuid())
  sellerId           String
  storeId            String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  seller             Sellers            @relation(fields: [sellerId], references: [id])
  store              Stores?            @relation(fields: [storeId], references: [id])
  verifiedByAdmin    Users?             @relation(fields: [verifiedById], references: [id])
  documents          Documents[]
}

model Documents {
  id                      String                @id @default(cuid())
  documentVerificationsId String
  fileId                  String
  documentType            DOCUMENTTYPES
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  documentVerification    DocumentVerifications @relation(fields: [documentVerificationsId], references: [id])
  files                   Files                 @relation(fields: [fileId], references: [id])
}

enum DOCUMENTTYPES {
  TIN_ID
  GOV_ID
  DTI_CERTIFICATE
  MAYORS_PERMIT
  BIR_CERTIFICATE
  SEC_CERTIFICATE
}

model AdminInvites {
  id        String       @id @default(cuid())
  email     String       @unique
  token     String       @unique
  status    INVITESTATUS @default(PENDING)
  inviterId String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  inviter   Users        @relation(fields: [inviterId], references: [id])
}

enum INVITESTATUS {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// =========================================================================
// 🏪 FEATURE DOMAIN: STORES & SELLERS
// =========================================================================

model Stores {
  id                    String                  @id @default(cuid())
  sellerId              String
  storeName             String
  description           String?
  logo                  String?
  banner                String?
  slug                  String?                 @unique
  phone                 String?
  email                 String?
  returnPolicy          String?
  shippingPolicy        String?
  socialLinks           Json?
  rating                Float                   @default(0)
  followersCount        Int                     @default(0)
  vacationMode          Boolean                 @default(false)
  isActive              Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  documentVerifications DocumentVerifications[]
  products              Products[]
  storeHours            StoreHours[]
  storeLocations        StoreLocations?
  storeReviews          StoreReviews[]
  seller                Sellers                 @relation(fields: [sellerId], references: [id])
  categories            Categories[]            @relation("CategoriesToStores")
  orders                Orders[]
  inventory             Inventory[]
  inventoryMovements    InventoryMovements[]

  @@index([sellerId])
  @@index([isActive])
}

model StoreHours {
  id        String   @id @default(cuid())
  storeId   String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Stores   @relation(fields: [storeId], references: [id])
}

model StoreLocations {
  id             String   @id @default(cuid())
  storeId        String   @unique
  currentAddress String
  homeAddress    String
  city           String
  province       String
  zipCode        String
  country        String
  latitude       Float
  longitude      Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Stores   @relation(fields: [storeId], references: [id])

  @@index([latitude, longitude])
}

model StoreReviews {
  id        String   @id @default(cuid())
  storeId   String
  buyerId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Stores   @relation(fields: [storeId], references: [id])
  buyer     Buyers   @relation(fields: [buyerId], references: [id])
}

// =========================================================================
// 📦 FEATURE DOMAIN: PRODUCTS & CATALOG MANAGEMENT
// =========================================================================

enum PRODUCTSTATUS {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  HIDDEN
}

model Products {
  id            String        @id @default(cuid())
  storeId       String
  productFileId String?
  categoryId    String?
  name          String
  brand         String?
  description   String?
  price         Decimal       @db.Decimal(12, 2)
  isActive      Boolean       @default(false)
  status        PRODUCTSTATUS @default(APPROVED)
  totalSold     Int           @default(0)
  listedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  store              Stores               @relation(fields: [storeId], references: [id])
  productFile        Files?               @relation(fields: [productFileId], references: [id])
  category           Categories?          @relation(fields: [categoryId], references: [id])
  tags               Tags[]
  inventory          Inventory[]
  orderitems         OrderItems[]
  productImages      ProductImages[]
  supplierProducts   SupplierProducts[]
  variants           ProductVariants[]
  options            ProductOptions[]
  reviews            ProductReviews[]
  cartItems          CartItems[]
  wishlistItems      WishlistItems[]
  inventoryMovements InventoryMovements[]

  @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([status])
  @@index([storeId, status, isActive])
  @@index([categoryId, status, isActive])
}

model ProductVariants {
  id          String    @id @default(cuid())
  productId   String
  sku         String?   @unique
  variantName String
  price       Decimal   @db.Decimal(12, 2)
  costPrice   Decimal?  @db.Decimal(12, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  product            Products                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues       ProductVariantToOptionValue[]
  inventory          Inventory[]
  orderitems         OrderItems[]
  productImages      ProductImages[]
  cartItems          CartItems[]
  wishlistItems      WishlistItems[]
  inventoryMovements InventoryMovements[]

  @@index([productId])
  @@index([sku])
}

model ProductOptions {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Products              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValues[]

  @@index([productId])
}

model ProductOptionValues {
  id        String   @id @default(cuid())
  optionId  String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  option   ProductOptions                @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantToOptionValue[]

  @@index([optionId])
}

model ProductVariantToOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariants     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValues @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
}

model SupplierProducts {
  id              String   @id @default(cuid())
  sellerId        String
  productId       String
  supplierSku     String?  @unique
  costPrice       Decimal? @db.Decimal(12, 2)
  minimumOrderQty Int      @default(1)
  supplyLeadDays  Int      @default(1)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller  Sellers  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product Products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([productId])
}

model Categories {
  id             String           @id @default(cuid())
  name           String           @unique
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isActive       Boolean          @default(true)
  parentId       String?
  parent         Categories?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Categories[]     @relation("CategoryHierarchy")
  products       Products[]
  stores         Stores[]         @relation("CategoriesToStores")
  commissionRule CommissionRules?

  @@index([parentId])
  @@index([name])
}

model Tags {
  id        String   @id @default(cuid())
  productId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Products @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryStatus {
  PENDING
  APPROVED
  REJECTED
}

// =========================================================================
// 🛒 FEATURE DOMAIN: ORDERS, CHECKOUT & INVENTORY
// =========================================================================

model Orders {
  id                   String           @id @default(cuid())
  buyerId              String
  storeId              String
  totalAmount          Decimal          @db.Decimal(12, 2)
  subtotalAmount       Decimal          @default(0) @db.Decimal(12, 2)
  shippingAmount       Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal          @default(0) @db.Decimal(12, 2)
  marketplaceFeeAmount Decimal          @default(0) @db.Decimal(12, 2)
  sellerNetAmount      Decimal          @default(0) @db.Decimal(12, 2)
  paymentFeeAmount     Decimal          @default(0) @db.Decimal(12, 2)
  currency             String           @default("PHP")
  version              Int              @default(0)
  type                 FULLFILLMENTTYPE @default(PICKUP)
  status               ORDERSTATUS      @default(PENDING)
  pickupAt             DateTime?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  buyer          Buyers           @relation(fields: [buyerId], references: [id])
  store          Stores           @relation(fields: [storeId], references: [id])
  orderitems     OrderItems[]
  payment        Payments[]
  settlement     Settlements?
  shipment       Shipments?
  returnRequests ReturnRequests[]

  @@index([buyerId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@index([buyerId, status])
  @@index([storeId, status])
}

enum FULLFILLMENTTYPE {
  DELIVERY
  PICKUP
}

enum ORDERSTATUS {
  PENDING
  PROCESSING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  FAILED
}

model OrderItems {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  productName  String?
  variantName  String?
  productSku   String?
  productBrand String?
  productImage String?
  categoryName String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order   Orders           @relation(fields: [orderId], references: [id])
  product Products         @relation(fields: [productId], references: [id])
  variant ProductVariants? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model ProductImages {
  id           String   @id @default(cuid())
  productId    String
  variantId    String?
  fileId       String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  product Products         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariants? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  file    Files            @relation(fields: [fileId], references: [id])

  @@index([productId])
  @@index([variantId])
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String
  variantId        String?
  storeId          String
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product   Products             @relation(fields: [productId], references: [id])
  variant   ProductVariants?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store     Stores               @relation(fields: [storeId], references: [id])
  movements InventoryMovements[]

  @@unique([storeId, productId, variantId])
  @@index([productId])
  @@index([storeId])
}

// =========================================================================
// 💳 FEATURE DOMAIN: PAYMENTS, SETTLEMENTS & FINANCIAL LEDGER
// =========================================================================

model Payments {
  id               String        @id @default(cuid())
  orderId          String
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PAYMENTMETHOD
  status           PAYMENTSTATUS @default(PENDING)
  referenceNumber  String?       @unique
  gateway          String?
  gatewayReference String?
  gatewayFee       Decimal       @default(0) @db.Decimal(12, 2)
  currency         String        @default("PHP")
  rawResponse      Json?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order Orders @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

enum PAYMENTMETHOD {
  BANK
  E_WALLET
  CASH_ON_DELIVERY
}

enum PAYMENTSTATUS {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model CommissionRules {
  id             String   @id @default(cuid())
  categoryId     String?  @unique
  commissionRate Decimal  @default(0.05) @db.Decimal(5, 4)
  fixedFee       Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Categories? @relation(fields: [categoryId], references: [id])
}

model Settlements {
  id                  String           @id @default(cuid())
  orderId             String           @unique
  sellerId            String
  subtotalAmount      Decimal          @db.Decimal(12, 2)
  commissionAmount    Decimal          @db.Decimal(12, 2)
  paymentFeeAmount    Decimal          @db.Decimal(12, 2)
  sellerNetAmount     Decimal          @db.Decimal(12, 2)
  status              SETTLEMENTSTATUS @default(PENDING)
  releaseEligibleAt   DateTime
  settledAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  order      Orders             @relation(fields: [orderId], references: [id])
  seller     Sellers            @relation(fields: [sellerId], references: [id])
  payoutItem SellerPayoutItems?

  @@index([sellerId])
  @@index([status])
}

enum SETTLEMENTSTATUS {
  PENDING
  HELD
  RELEASED
  REFUNDED
}

model SellerPayouts {
  id           String              @id @default(cuid())
  sellerId     String
  payoutNumber String              @unique
  totalAmount  Decimal             @db.Decimal(12, 2)
  status       PAYOUTSTATUS        @default(PENDING)
  payoutMethod String
  referenceNo  String?
  processedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  seller Sellers             @relation(fields: [sellerId], references: [id])
  items  SellerPayoutItems[]

  @@index([sellerId])
  @@index([status])
}

model SellerPayoutItems {
  id           String   @id @default(cuid())
  payoutId     String
  settlementId String   @unique
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  payout     SellerPayouts @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  settlement Settlements   @relation(fields: [settlementId], references: [id])

  @@index([payoutId])
}

enum PAYOUTSTATUS {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BuyerAddresses {
  id            String      @id @default(cuid())
  buyerId       String
  addressType   ADDRESSTYPE @default(SHIPPING)
  recipientName String
  phoneNumber   String
  streetAddress String
  city          String
  province      String
  zipCode       String
  country       String      @default("Philippines")
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  buyer Buyers @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
}

enum ADDRESSTYPE {
  SHIPPING
  BILLING
  HOME
  OFFICE
}

model ProductReviews {
  id        String   @id @default(cuid())
  productId String
  buyerId   String
  orderId   String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Products @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   Buyers   @relation(fields: [buyerId], references: [id])

  @@index([productId])
  @@index([buyerId])
}

model Carts {
  id        String      @id @default(cuid())
  buyerId   String      @unique
  expiresAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyer Buyers     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items CartItems[]
}

model CartItems {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  variantId     String?
  quantity      Int
  priceSnapshot Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Carts            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Products         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariants? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model Wishlists {
  id        String          @id @default(cuid())
  buyerId   String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  buyer Buyers          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items WishlistItems[]
}

model WishlistItems {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  wishlist Wishlists        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Products         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariants? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
}

enum INVENTORYMOVEMENTTYPE {
  RESTOCK
  SALE
  RETURN
  TRANSFER
  ADJUSTMENT
}

model InventoryMovements {
  id             String                @id @default(cuid())
  inventoryId    String
  productId      String
  variantId      String?
  storeId        String
  movementType   INVENTORYMOVEMENTTYPE
  quantityDelta  Int
  previousOnHand Int
  newOnHand      Int
  referenceId    String?
  note           String?
  createdById    String?
  createdAt      DateTime              @default(now())

  inventory Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Products         @relation(fields: [productId], references: [id])
  variant   ProductVariants? @relation(fields: [variantId], references: [id])
  store     Stores           @relation(fields: [storeId], references: [id])

  @@index([inventoryId])
  @@index([productId])
  @@index([storeId])
}

enum SHIPMENTSTATUS {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model Shipments {
  id             String         @id @default(cuid())
  orderId        String         @unique
  courier        String
  trackingNumber String?        @unique
  shippingFee    Decimal        @default(0) @db.Decimal(12, 2)
  labelUrl       String?
  status         SHIPMENTSTATUS @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Orders @relation(fields: [orderId], references: [id])

  @@index([status])
}

enum RETURNSTATUS {
  PENDING
  APPROVED
  REJECTED
  ITEM_RECEIVED
  REFUNDED
}

model ReturnRequests {
  id           String       @id @default(cuid())
  orderId      String
  buyerId      String
  sellerId     String
  reason       String
  status       RETURNSTATUS @default(PENDING)
  refundAmount Decimal      @db.Decimal(12, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order  Orders  @relation(fields: [orderId], references: [id])
  buyer  Buyers  @relation(fields: [buyerId], references: [id])
  seller Sellers @relation(fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
}

model AuditLogs {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}

model Notifications {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}
