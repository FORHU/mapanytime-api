enum PRICINGSTATUS {
  DRAFT
  ACTIVE
  SCHEDULED
  EXPIRED
  ARCHIVED
}

enum PRICINGCOMPONENTTYPE {
  BUYER_TRANSACTION_FEE
  SELLER_MARKETPLACE_FEE
  PAYMENT_PROCESSING_FEE
  FIXED_TRANSACTION_FEE
  WITHDRAWAL_FEE
  ADVERTISING_FEE
}

enum PRICINGCALCULATIONTYPE {
  PERCENTAGE
